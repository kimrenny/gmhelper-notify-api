APP_ENV=development
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
DATABASE_URL=postgres://notify_user:notify_password@postgres:5432/notify_db?sslmode=disable
# SMTP Configuration (Local Mailpit by default; can also use production Gmail / gmhelper-api SMTP format)
# Local Mailpit (Docker / Local Dev):
SMTP_HOST=smtp
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@gmhelper.local

# Production / gmhelper-api format:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=prodmail@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=prodmail@gmail.com
# (.NET style aliases SMTP__Host, SMTP_Port, SMTP__Username, SMTP__Password, SMTP__From are also supported)
LOG_LEVEL=info
ALLOWED_CORS_ORIGINS=*
NOTIFY_AUTH_ISSUER=GMHelperAPI
NOTIFY_AUTH_AUDIENCE=GMHelperClient
NOTIFY_AUTH_SECRET=c283114c605c4c78adfefef864c575266d8ce3c7a23445eda7afd6c28671e8c3
NOTIFY_WORKER_ENABLED=true
NOTIFY_WORKER_INTERVAL=5s
NOTIFY_WORKER_STALE_TIMEOUT=5m
NOTIFY_WORKER_MAX_ATTEMPTS=5

# Campaign Scheduler & Delivery Workers
NOTIFY_SCHEDULER_ENABLED=true
NOTIFY_SCHEDULER_INTERVAL=5s
NOTIFY_SCHEDULER_BATCH_SIZE=10
NOTIFY_CAMPAIGN_WORKER_ENABLED=true
NOTIFY_CAMPAIGN_WORKER_INTERVAL=5s
NOTIFY_CAMPAIGN_WORKER_BATCH_SIZE=20
NOTIFY_CAMPAIGN_WORKER_STALE_TIMEOUT=5m

# gmhelper-api User Resolution Integration
GMHELPER_API_BASE_URL=http://localhost:7057
NOTIFY_SERVICE_AUTH_ISSUER=GMHelperAPI
NOTIFY_SERVICE_AUTH_AUDIENCE=GMHelperClient
NOTIFY_SERVICE_AUTH_SECRET=c283114c605c4c78adfefef864c575266d8ce3c7a23445eda7afd6c28671e8c3
